+def _get_mimo_gfx950_d192_occupancy_override() -> int:
+    """Return the opt-in block-per-CU search value, or -1 for CK policy."""
+    value = os.getenv("AITER_MIMO_GFX950_D192_OCCUPANCY")
+    if value is None or value == "":
+        return -1
+    try:
+        occupancy = int(value)
+    except ValueError as error:
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_OCCUPANCY must be one of 1, 2, or 3"
+        ) from error
+    if occupancy not in (1, 2, 3):
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_OCCUPANCY must be one of 1, 2, or 3; "
+            f"got {value!r}"
+        )
+    return occupancy
+
+
+def _make_mimo_gfx950_d192_v128_tile(
+    m0: int, n0: int, occupancy: int = -1
+) -> FmhaFwdTileSize:
+    """Build one CDNA4 MiMo Q/K192-V/O128 tile for tuning."""
+    # CDNA4 uses 32x32x32 FP8 warp GEMMs. M0 is an integer number of M warps;
+    # N0 remains a pipeline tile/loop extent.  Q/K consume 192 elements while
+    # the PV GEMM and output epilogue operate on the physical V/O width 128.
+    m_warps = m0 // 32
+    return FmhaFwdTileSize(
+        m0,
+        n0,
+        32,
+        128,
+        32,
+        192,
+        m_warps,
+        1,
+        1,
+        m_warps,
+        1,
+        1,
+        32,
+        32,
+        32,
+        32,
+        32,
+        32,
+        occupancy,
+    )
+
+
+def _get_mimo_gfx950_d192_tile_override() -> Optional[FmhaFwdTileSize]:
+    """Return one opt-in Q/K192-V128 tile without changing default dispatch."""
+    value = os.getenv("AITER_MIMO_GFX950_D192_TILE")
+    if not value:
+        return None
+    try:
+        m0, n0 = (int(part) for part in value.lower().split("x", maxsplit=1))
+    except (TypeError, ValueError) as error:
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_TILE must use MxN form, for example 64x96"
+        ) from error
+    if (m0, n0) not in _MIMO_GFX950_D192_SEARCH_TILES:
+        supported = ", ".join(
+            f"{tile_m}x{tile_n}"
+            for tile_m, tile_n in sorted(_MIMO_GFX950_D192_SEARCH_TILES)
+        )
+        raise ValueError(
+            f"Unsupported gfx950 D192 search tile {value!r}; choose one of: {supported}"
+        )
+    return _make_mimo_gfx950_d192_v128_tile(
+        m0, n0, _get_mimo_gfx950_d192_occupancy_override()
+    )
+
