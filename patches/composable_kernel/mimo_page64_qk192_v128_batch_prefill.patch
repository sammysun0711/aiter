+        # time, so native V128 uses the closest legal 128x96 geometry.
+        primary = FmhaFwdTileSize(128, 96, 32, 128, 32, 192,  4, 1, 1,  4, 1, 1,  32, 32, 32,  32, 32, 32,  -1)
+        padded = FmhaFwdTileSize(192, 96, 32, 192, 32, 192,  6, 1, 1,  6, 1, 1,  32, 32, 32,  32, 32, 32,  -1)
+    return [primary, padded]
