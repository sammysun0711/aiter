+    """Return the opt-in block-per-CU search value, or -1 for CK policy."""
+    value = os.getenv("AITER_MIMO_GFX950_D192_OCCUPANCY")
+    if value is None or value == "":
+        return -1
+    try:
+        occupancy = int(value)
+    except ValueError as error:
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_OCCUPANCY must be one of 1, 2, or 3"
+        ) from error
+    if occupancy not in (1, 2, 3):
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_OCCUPANCY must be one of 1, 2, or 3; "
+            f"got {value!r}"
+        )
+    return occupancy
