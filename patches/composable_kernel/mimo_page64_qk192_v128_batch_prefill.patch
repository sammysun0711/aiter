+def _get_mimo_gfx950_d192_tile_override() -> Optional[FmhaFwdTileSize]:
+    """Return one opt-in Q/K192-V128 tile without changing default dispatch."""
+    value = os.getenv("AITER_MIMO_GFX950_D192_TILE")
+    if not value:
+        return None
+    try:
+        m0, n0 = (int(part) for part in value.lower().split("x", maxsplit=1))
+    except (TypeError, ValueError) as error:
+        raise ValueError(
+            "AITER_MIMO_GFX950_D192_TILE must use MxN form, for example 64x96"
+        ) from error
+    if (m0, n0) not in _MIMO_GFX950_D192_SEARCH_TILES:
+        supported = ", ".join(
+            f"{tile_m}x{tile_n}"
+            for tile_m, tile_n in sorted(_MIMO_GFX950_D192_SEARCH_TILES)
+        )
+        raise ValueError(
+            f"Unsupported gfx950 D192 search tile {value!r}; choose one of: {supported}"
+        )
+    return _make_mimo_gfx950_d192_v128_tile(
+        m0, n0, _get_mimo_gfx950_d192_occupancy_override()
+    )
