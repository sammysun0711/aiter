+def _make_mimo_gfx950_d192_v128_tile(
+    m0: int, n0: int, occupancy: int = -1
+) -> FmhaFwdTileSize:
+    """Build one CDNA4 MiMo Q/K192-V/O128 tile for tuning."""
+    # CDNA4 uses 32x32x32 FP8 warp GEMMs. M0 is an integer number of M warps;
+    # N0 remains a pipeline tile/loop extent.  Q/K consume 192 elements while
+    # the PV GEMM and output epilogue operate on the physical V/O width 128.
+    m_warps = m0 // 32
+    return FmhaFwdTileSize(
+        m0,
+        n0,
+        32,
+        128,
+        32,
+        192,
+        m_warps,
+        1,
+        1,
+        m_warps,
+        1,
+        1,
+        32,
+        32,
+        32,
+        32,
+        32,
+        32,
+        occupancy,
+    )
+
