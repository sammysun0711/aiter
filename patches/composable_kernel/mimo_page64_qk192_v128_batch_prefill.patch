+def _get_single_mimo_target(targets: Optional[List[str]]) -> Optional[str]:
+    """Return the explicit MiMo target used by AITER's runtime JIT recipe."""
+    if targets is None or len(targets) != 1:
+        return None
+    target = targets[0].split(":", maxsplit=1)[0]
+    if target.startswith("gfx950"):
+        return "gfx950"
+    if target.startswith("gfx942"):
+        return "gfx942"
+    return None
