+def _get_mimo_gfx942_bf16_linear_tile() -> FmhaFwdTileSize:
+    """Small, separately cached search space for MiMo's LINEAR SWA fallback."""
+    value = os.getenv("AITER_MIMO_GFX942_LINEAR_TILE", "128x64")
+    choices = {
+        "64x64": (64, 64),
+        "64x128": (64, 128),
+        "128x64": (128, 64),
+        "128x128": (128, 128),
+    }
+    if value not in choices:
+        raise ValueError(
+            f"AITER_MIMO_GFX942_LINEAR_TILE must be one of {sorted(choices)}"
+        )
+    m0, n0 = choices[value]
+    warps = m0 // 32
+    return FmhaFwdTileSize(
+        m0, n0, 32, 128, 32, 192, warps, 1, 1, warps, 1, 1,
+        32, 32, 16, 32, 32, 16, -1,
+    )
