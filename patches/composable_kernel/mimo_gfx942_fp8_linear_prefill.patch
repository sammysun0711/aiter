+def _get_mimo_gfx942_fp8_linear_tile() -> FmhaFwdTileSize:
+    """Native FP8 Q/K192-V128 tiles, independent of the BF16 tuning."""
+    value = os.getenv("AITER_MIMO_GFX942_FP8_LINEAR_TILE", "128x96")
+    choices = {
+        "64x64": (64, 64),
+        "64x96": (64, 96),
+        "64x128": (64, 128),
+        "128x64": (128, 64),
+        "128x96": (128, 96),
+        "128x128": (128, 128),
+    }
+    if value not in choices:
+        raise ValueError(
+            f"AITER_MIMO_GFX942_FP8_LINEAR_TILE must be one of {sorted(choices)}"
+        )
+    m0, n0 = choices[value]
+    warps = m0 // 32
+    return FmhaFwdTileSize(
+        m0, n0, 32, 128, 32, 192, warps, 1, 1, warps, 1, 1,
+        32, 32, 32, 32, 32, 32, -1,
+    )
+
